---
import { type CollectionEntry } from 'astro:content';
import { format } from 'date-fns';
import { de } from 'date-fns/locale';

interface Props {
  entry: CollectionEntry<'changelogs'> | CollectionEntry<'table-reservations'> | CollectionEntry<'shop'>;
  type?: 'changelog' | 'reservation' | 'shop'; // Explicit type override if needed
}

const { entry } = Astro.props;
const data = entry.data;

// Normalize data
const title = data.title;
const date = data.date;
const slug = entry.slug;
// @ts-ignore
const version = data.version;
// @ts-ignore
const entryType = data.type; // feature, fix, breaking
// @ts-ignore
const category = data.category;
// @ts-ignore
const status = data.status;

const isChangelog = 'version' in data;
const collectionName = entry.collection;

const typeColors = {
  feature: 'bg-green-100 text-green-800',
  fix: 'bg-blue-100 text-blue-800',
  breaking: 'bg-red-100 text-red-800',
  default: 'bg-gray-100 text-gray-800'
};

const labels = {
  feature: 'Feature',
  fix: 'Fix',
  breaking: 'Breaking',
  live: 'Live',
  planned: 'Geplant'
};

const badgeColor = isChangelog ? (typeColors[entryType as keyof typeof typeColors] || typeColors.default) : 'bg-purple-100 text-purple-800';
const badgeText = isChangelog ? (labels[entryType as keyof typeof labels] || entryType) : (labels[status as keyof typeof labels] || status);

---

<a href={`/${collectionName}/${slug}`} class="block group">
  <article class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 transition-all hover:shadow-md hover:border-blue-200 h-full flex flex-col">
    <div class="flex items-start justify-between mb-4">
      <div class="flex items-center gap-2 flex-wrap">
        <span class={`px-2.5 py-0.5 rounded-full text-xs font-medium uppercase tracking-wide ${badgeColor}`}>
          {badgeText}
        </span>
        {category && (
          <span class="bg-gray-100 text-gray-600 px-2.5 py-0.5 rounded-full text-xs font-medium">
            {category === 'Table Reservations' ? 'Tischreservierungen' : category}
          </span>
        )}
      </div>
      <time datetime={date.toISOString()} class="text-sm text-gray-500 whitespace-nowrap">
        {format(date, 'dd. MMM yyyy', { locale: de })}
      </time>
    </div>
    
    <h3 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors mb-2">
      {title}
    </h3>
    
    {version && (
      <div class="text-sm font-mono text-gray-500 mb-4">
        v{version}
      </div>
    )}
    
    <div class="prose prose-sm text-gray-600 line-clamp-3 mt-auto">
      {entry.body}
    </div>
  </article>
</a>
