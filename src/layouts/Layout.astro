---
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
  maxWidth?: string;
}

const { title, maxWidth = 'max-w-4xl' } = Astro.props;
---

<!doctype html>
<html lang="de" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Bringmal.de Changelog" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title="Bringmal Changelog RSS Feed" href="/rss.xml" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <ClientRouter />
	</head>
	<body class="bg-gray-50 text-gray-900 font-sans min-h-screen flex flex-col">
		<main class={`flex-grow container mx-auto px-4 py-8 ${maxWidth}`}>
			<slot />
		</main>
    <footer class="py-6 text-center text-gray-500 text-sm">
      <div class="mb-2">
        <a href="/rss.xml" class="inline-flex items-center gap-1 hover:text-gray-700 transition-colors" title="RSS Feed abonnieren">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path d="M5 3a1 1 0 000 2c5.523 0 10 4.477 10 10a1 1 0 102 0C17 8.373 11.627 3 5 3z"/>
            <path d="M4 9a1 1 0 011-1 7 7 0 017 7 1 1 0 11-2 0 5 5 0 00-5-5 1 1 0 01-1-1zM3 15a2 2 0 114 0 2 2 0 01-4 0z"/>
          </svg>
          RSS Feed
        </a>
      </div>
      <div>
        &copy; {new Date().getFullYear()} Bringmal.de. Alle Rechte vorbehalten.
      </div>
    </footer>
	</body>
</html>
