---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Content Manager</title>
  </head>
  <body>
    <div id="cms-status" style="padding: 20px; font-family: monospace; color: #666;">
      Loading CMS...
    </div>

    <!-- 1. Disable auto-init -->
    <script is:inline>window.CMS_MANUAL_INIT = true;</script>

    <!-- 2. Include the script -->
    <script src="https://unpkg.com/decap-cms@^3.1.2/dist/decap-cms.js"></script>
    
    <!-- 3. Safe Initialization Script -->
    <script is:inline>
      (function() {
        const statusDiv = document.getElementById('cms-status');
        const maxAttempts = 100; // 10 seconds
        let attempts = 0;

        function log(msg, isError = false) {
          console.log(msg);
          if (statusDiv) {
             // Only show errors or final status on screen to avoid clutter
             if (isError) statusDiv.innerHTML += `<br><span style="color:red">${msg}</span>`;
          }
        }

        const interval = setInterval(() => {
          attempts++;
          const CMS = window.CMS || window.NetlifyCMS;

          if (CMS) {
            clearInterval(interval);
            statusDiv.style.display = 'none'; // Hide status if successful
            initCMS(CMS);
          } else if (attempts >= maxAttempts) {
            clearInterval(interval);
            log('Timeout: Could not find window.CMS object.', true);
          }
        }, 100);

        function initCMS(CMS) {
          try {
            CMS.init({
              config: {
                backend: {
                  name: 'github',
                  repo: 'kevineulenberg/bringmal-changelog',
                  branch: 'main',
                  base_url: window.location.origin,
                  auth_endpoint: 'oauth'
                },
                media_folder: "public/images/uploads",
                public_folder: "/images/uploads",
                collections: [
                  {
                    name: "changelogs",
                    label: "Changelogs",
                    folder: "src/content/changelogs",
                    create: true,
                    slug: "{{slug}}",
                    fields: [
                      { label: "Title", name: "title", widget: "string" },
                      { label: "Version", name: "version", widget: "string" },
                      { label: "Date", name: "date", widget: "datetime" },
                      { label: "Type", name: "type", widget: "select", options: ["feature", "fix", "breaking"] },
                      { label: "Category", name: "category", widget: "select", options: ["Table Reservations", "Shop"] },
                      { label: "Body", name: "body", widget: "markdown" }
                    ]
                  },
                  {
                    name: "table-reservations",
                    label: "Table Reservations",
                    folder: "src/content/table-reservations",
                    create: true,
                    slug: "{{slug}}",
                    fields: [
                      { label: "Title", name: "title", widget: "string" },
                      { label: "Date", name: "date", widget: "datetime" },
                      { label: "Status", name: "status", widget: "select", options: ["live", "planned"] },
                      { label: "Body", name: "body", widget: "markdown" }
                    ]
                  },
                  {
                    name: "shop",
                    label: "Shop",
                    folder: "src/content/shop",
                    create: true,
                    slug: "{{slug}}",
                    fields: [
                      { label: "Title", name: "title", widget: "string" },
                      { label: "Date", name: "date", widget: "datetime" },
                      { label: "Status", name: "status", widget: "select", options: ["live", "planned"] },
                      { label: "Body", name: "body", widget: "markdown" }
                    ]
                  }
                ]
              }
            });
            console.log('CMS initialized!');
          } catch (e) {
            log('Init Error: ' + e.message, true);
            console.error(e);
          }
        }
      })();
    </script>
  </body>
</html>
