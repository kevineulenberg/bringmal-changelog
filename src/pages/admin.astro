---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Content Manager</title>
  </head>
  <body>
    <!-- 1. Disable auto-init -->
    <script is:inline>window.CMS_MANUAL_INIT = true;</script>

    <!-- 2. Include the script -->
    <script src="https://unpkg.com/decap-cms@^3.1.2/dist/decap-cms.js"></script>
    
    <!-- 3. Poll for CMS object and initialize -->
    <script is:inline>
      const maxAttempts = 50; // 5 seconds total
      let attempts = 0;

      const initInterval = setInterval(() => {
        attempts++;
        const CMS = window.CMS || window.NetlifyCMS;

        if (CMS) {
          clearInterval(initInterval);
          console.log('CMS object found. Initializing...');
          initializeCMS(CMS);
        } else if (attempts >= maxAttempts) {
          clearInterval(initInterval);
          console.error('Timeout: CMS object not found after 5 seconds.');
          document.body.innerHTML = '<div style="padding: 20px; color: red;"><h1>Error Loading CMS</h1><p>The CMS library failed to load. Please refresh the page or check your internet connection.</p></div>';
        }
      }, 100);

      function initializeCMS(CMS) {
        try {
          CMS.init({
            config: {
              backend: {
                name: 'github',
                repo: 'kevineulenberg/bringmal-changelog',
                branch: 'main',
                base_url: window.location.origin,
                auth_endpoint: 'api/auth'
              },
              media_folder: "public/images/uploads",
              public_folder: "/images/uploads",
              collections: [
                {
                  name: "changelogs",
                  label: "Changelogs",
                  folder: "src/content/changelogs",
                  create: true,
                  slug: "{{slug}}",
                  fields: [
                    { label: "Title", name: "title", widget: "string" },
                    { label: "Version", name: "version", widget: "string" },
                    { label: "Date", name: "date", widget: "datetime" },
                    { label: "Type", name: "type", widget: "select", options: ["feature", "fix", "breaking"] },
                    { label: "Category", name: "category", widget: "select", options: ["Table Reservations", "Shop"] },
                    { label: "Body", name: "body", widget: "markdown" }
                  ]
                },
                {
                  name: "table-reservations",
                  label: "Table Reservations",
                  folder: "src/content/table-reservations",
                  create: true,
                  slug: "{{slug}}",
                  fields: [
                    { label: "Title", name: "title", widget: "string" },
                    { label: "Date", name: "date", widget: "datetime" },
                    { label: "Status", name: "status", widget: "select", options: ["live", "planned"] },
                    { label: "Body", name: "body", widget: "markdown" }
                  ]
                },
                {
                  name: "shop",
                  label: "Shop",
                  folder: "src/content/shop",
                  create: true,
                  slug: "{{slug}}",
                  fields: [
                    { label: "Title", name: "title", widget: "string" },
                    { label: "Date", name: "date", widget: "datetime" },
                    { label: "Status", name: "status", widget: "select", options: ["live", "planned"] },
                    { label: "Body", name: "body", widget: "markdown" }
                  ]
                }
              ]
            }
          });
          console.log('CMS initialized successfully.');
        } catch (e) {
          console.error('CMS Initialization Error:', e);
          document.body.innerHTML = `<div style="padding: 20px; color: red;"><h1>Configuration Error</h1><p>${e.message}</p></div>`;
        }
      }
    </script>
  </body>
</html>