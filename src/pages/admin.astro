---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Content Manager</title>
  </head>
  <body>
    <!-- 1. Disable auto-init -->
    <script is:inline>window.CMS_MANUAL_INIT = true;</script>

    <!-- 2. Define the init function -->
    <script is:inline>
      function initCMS() {
        console.log('Decap CMS script loaded. Initializing...');
        if (!window.CMS) {
          console.error('window.CMS is undefined!');
          document.body.innerHTML = '<h1 style="color:red; padding: 20px;">Error: Decap CMS failed to load. Check console.</h1>';
          return;
        }

        const CMS = window.CMS;
        
        try {
          CMS.init({
            config: {
              backend: {
                name: 'github',
                repo: 'kevineulenberg/bringmal-changelog',
                branch: 'main',
                base_url: window.location.origin,
                auth_endpoint: 'api/auth'
              },
              media_folder: "public/images/uploads",
              public_folder: "/images/uploads",
              collections: [
                {
                  name: "changelogs",
                  label: "Changelogs",
                  folder: "src/content/changelogs",
                  create: true,
                  slug: "{{slug}}",
                  fields: [
                    { label: "Title", name: "title", widget: "string" },
                    { label: "Version", name: "version", widget: "string" },
                    { label: "Date", name: "date", widget: "datetime" },
                    { label: "Type", name: "type", widget: "select", options: ["feature", "fix", "breaking"] },
                    { label: "Category", name: "category", widget: "select", options: ["Table Reservations", "Shop"] },
                    { label: "Body", name: "body", widget: "markdown" }
                  ]
                },
                {
                  name: "table-reservations",
                  label: "Table Reservations",
                  folder: "src/content/table-reservations",
                  create: true,
                  slug: "{{slug}}",
                  fields: [
                    { label: "Title", name: "title", widget: "string" },
                    { label: "Date", name: "date", widget: "datetime" },
                    { label: "Status", name: "status", widget: "select", options: ["live", "planned"] },
                    { label: "Body", name: "body", widget: "markdown" }
                  ]
                },
                {
                  name: "shop",
                  label: "Shop",
                  folder: "src/content/shop",
                  create: true,
                  slug: "{{slug}}",
                  fields: [
                    { label: "Title", name: "title", widget: "string" },
                    { label: "Date", name: "date", widget: "datetime" },
                    { label: "Status", name: "status", widget: "select", options: ["live", "planned"] },
                    { label: "Body", name: "body", widget: "markdown" }
                  ]
                }
              ]
            }
          });
          console.log('CMS.init() called successfully.');
        } catch (e) {
          console.error('Error during CMS.init():', e);
          document.body.innerHTML = `<h1 style="color:red; padding: 20px;">Error initializing CMS: ${e.message}</h1>`;
        }
      }
    </script>

    <!-- 3. Load the script and trigger init -->
    <script src="https://unpkg.com/decap-cms@^3.1.2/dist/decap-cms.js" onload="initCMS()"></script>
  </body>
</html>
